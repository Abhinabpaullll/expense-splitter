<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensesplitter.controller.SettingsController">

    <VBox spacing="24.0">
        <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
        </padding>

        <!-- Header -->
        <VBox spacing="4.0">
            <Label styleClass="text-title" text="Settings" />
            <Label styleClass="text-secondary" text="Interface appearance, regional currency preferences, reminders, and database backup" />
        </VBox>

        <!-- Feedback Banner -->
        <VBox fx:id="settingsFeedbackBox" managed="false" spacing="4.0" styleClass="card-subtle" visible="false">
            <Label fx:id="settingsFeedbackText" styleClass="text-label, text-positive" text="Settings updated." />
        </VBox>

        <!-- Section 1: Appearance & Theme -->
        <VBox spacing="16.0" styleClass="card">
            <VBox spacing="2.0">
                <Label styleClass="text-section" text="Appearance" />
                <Label styleClass="text-caption" text="Select your preferred workspace theme" />
            </VBox>

            <HBox spacing="24.0">
                <RadioButton fx:id="lightThemeRadio" onAction="#onSelectLightTheme" text="Light Canvas (#F7F7F5)">
                    <toggleGroup>
                        <ToggleGroup fx:id="themeToggleGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="darkThemeRadio" onAction="#onSelectDarkTheme" text="Dark Slate (#14171A)" toggleGroup="$themeToggleGroup" />
            </HBox>
        </VBox>

        <!-- Section 2: Regional Preferences -->
        <VBox spacing="16.0" styleClass="card">
            <VBox spacing="2.0">
                <Label styleClass="text-section" text="Currency &amp; formatting" />
                <Label styleClass="text-caption" text="Primary display currency symbol for amounts and ledger views" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label styleClass="form-label" text="Default Currency:" />
                <ComboBox fx:id="defaultCurrencyBox" prefWidth="200.0" />
            </HBox>
        </VBox>

        <!-- Section 3: Automated Reminders -->
        <VBox spacing="16.0" styleClass="card">
            <VBox spacing="2.0">
                <Label styleClass="text-section" text="Scheduled reminder engine" />
                <Label styleClass="text-caption" text="Periodic background execution to evaluate pending claims" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label styleClass="form-label" text="Check Frequency:" />
                <ComboBox fx:id="reminderFrequencyBox" prefWidth="220.0" />
            </HBox>
        </VBox>

        <!-- Section 4: Database Storage & Backup -->
        <VBox spacing="16.0" styleClass="card">
            <VBox spacing="2.0">
                <Label styleClass="text-section" text="Database storage &amp; backup" />
                <Label styleClass="text-caption" text="Offline SQLite data file backup and restoration" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Button onAction="#onBackupDatabase" styleClass="btn-primary" text="Backup database" />
                <Button onAction="#onRestoreDatabase" styleClass="btn-secondary" text="Restore from backup" />
            </HBox>
        </VBox>

        <!-- Section 5: Account Management -->
        <VBox spacing="16.0" styleClass="card">
            <VBox spacing="2.0">
                <Label styleClass="text-section" text="Account profile &amp; security" />
                <Label styleClass="text-caption" text="Manage your offline user profile, change password, or remove account" />
            </VBox>

            <!-- Display Name -->
            <VBox spacing="8.0">
                <Label styleClass="form-label" text="Display Name:" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <javafx.scene.control.TextField fx:id="accountDisplayNameField" prefWidth="280.0" promptText="Your name" />
                    <Button onAction="#onSaveDisplayName" styleClass="btn-secondary" text="Save name" />
                </HBox>
            </VBox>

            <!-- Change Password -->
            <VBox spacing="8.0">
                <Label styleClass="form-label" text="Change Password:" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <javafx.scene.control.PasswordField fx:id="currentPasswordField" prefWidth="180.0" promptText="Current password" />
                    <javafx.scene.control.PasswordField fx:id="newPasswordField" prefWidth="180.0" promptText="New password" />
                    <javafx.scene.control.PasswordField fx:id="confirmPasswordField" prefWidth="180.0" promptText="Confirm new" />
                    <Button onAction="#onUpdatePassword" styleClass="btn-secondary" text="Update password" />
                </HBox>
            </VBox>

            <!-- Danger Zone: Delete Account -->
            <VBox spacing="8.0">
                <Label styleClass="form-label" text="Account Removal:" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button onAction="#onDeleteAccount" styleClass="btn-secondary" text="Delete account" />
                    <Label styleClass="text-caption, text-negative" text="Removes account credentials. Shared group records remain intact." />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>

