<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensesplitter.controller.GroupDetailController">

    <VBox spacing="24.0">
        <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
        </padding>

        <!-- Breadcrumb Navigation -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button onAction="#onBackToGroups" styleClass="btn-tertiary" text="← Groups" />
            <Label styleClass="text-secondary" text="/" />
            <Label fx:id="breadcrumbGroupLabel" styleClass="text-label" text="Group" />
        </HBox>

        <!-- Group Header & Actions Bar -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="6.0">
                <Label fx:id="groupTitleLabel" styleClass="text-title" text="Group" />
                <HBox fx:id="memberTagsContainer" alignment="CENTER_LEFT" spacing="6.0" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onSettleUp" styleClass="btn-secondary" text="Settle up" />
            <Button onAction="#onAddExpense" styleClass="btn-primary" text="Add expense" />
        </HBox>

        <!-- Structural Tab Navigation (Expenses, Balances, Members) -->
        <HBox styleClass="segmented-control">
            <Button fx:id="tabExpensesBtn" onAction="#onShowExpensesTab" styleClass="active" text="Expenses" />
            <Button fx:id="tabBalancesBtn" onAction="#onShowBalancesTab" text="Balances" />
            <Button fx:id="tabMembersBtn" onAction="#onShowMembersTab" text="Members" />
        </HBox>

        <!-- Dynamic Content Stack for Selected Tab -->
        <StackPane fx:id="tabContentStack">
            <!-- Tab 1: Expenses Register -->
            <VBox fx:id="expensesTabBox" spacing="16.0">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <TextField fx:id="expenseSearchField" prefWidth="260.0" promptText="Search description or title..." />
                    <ComboBox fx:id="categoryFilterBox" prefWidth="160.0" promptText="All categories" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onExportLedger" styleClass="btn-secondary" text="Export statement" />
                </HBox>

                <TableView fx:id="expensesTable" minHeight="360.0" prefHeight="420.0">
                    <columns>
                        <TableColumn fx:id="colExpDate" prefWidth="110.0" text="Date" />
                        <TableColumn fx:id="colExpTitle" prefWidth="220.0" text="Description" />
                        <TableColumn fx:id="colExpPayer" prefWidth="130.0" text="Paid by" />
                        <TableColumn fx:id="colExpCategory" prefWidth="120.0" text="Category" />
                        <TableColumn fx:id="colExpAmount" prefWidth="120.0" styleClass="table-cell-mono" text="Amount" />
                        <TableColumn fx:id="colExpShare" prefWidth="120.0" styleClass="table-cell-mono" text="Your share" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Tab 2: Balances & Simplified Transfers -->
            <VBox fx:id="balancesTabBox" managed="false" spacing="20.0" visible="false">
                <Label styleClass="text-section" text="Member balances &amp; simplified settlements" />
                <HBox spacing="16.0">
                    <!-- Left: Individual Balances Cards -->
                    <VBox fx:id="individualBalancesContainer" spacing="12.0" HBox.hgrow="ALWAYS" />
                    <!-- Right: Debt Simplification Transfers -->
                    <VBox spacing="12.0" prefWidth="380.0" styleClass="card">
                        <Label styleClass="text-label" text="Greedy graph simplification" />
                        <Label styleClass="text-caption" text="Optimal transfers to settle all dues with zero residue" />
                        <VBox fx:id="simplifiedTransfersContainer" spacing="8.0" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Tab 3: Group Members Management -->
            <VBox fx:id="membersTabBox" managed="false" spacing="16.0" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label styleClass="text-section" text="Group members" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddMember" styleClass="btn-primary" text="Add member" />
                </HBox>
                <VBox fx:id="membersListContainer" spacing="8.0" />
            </VBox>
        </StackPane>
    </VBox>
</ScrollPane>

